# ==========================================
# Helpdesk Backend Environment Configuration Template
# Duplicate this file to .env and configure your values
# ==========================================

# Server Configuration
SERVER_PORT=8081

# Database Configuration (PostgreSQL / Supabase / MySQL)
DB_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
DB_DRIVER=org.postgresql.Driver

# JPA / Hibernate Configuration
JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
HIBERNATE_DDL_AUTO=update
SHOW_SQL=true

# JWT Security Configuration
JWT_SECRET=your_jwt_secret_key_which_should_be_long_enough_for_hs512
JWT_EXPIRATION_MS=86400000
